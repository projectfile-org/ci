# Generated by ci-resolver from org.projectfile.ci — DO NOT EDIT.
# Regenerate with: pf-ci generate --target {{ .Target.Key }}
# A freshness gate (pf-ci generate --check) runs in CI so this file cannot
# silently drift from the source DAG.
---
name: {{ .Name }}
"on":
{{- if .On.PushAny }}
  push: {}
{{- else if or .On.PushBranches .On.PushTags }}
  push:
{{- if .On.PushBranches }}
    branches: {{ yamlList .On.PushBranches }}
{{- end }}
{{- if .On.PushTags }}
    tags: ["**"]
{{- end }}
{{- end }}
{{- if .On.PullRequest }}
  pull_request: {}
{{- end }}
{{- with .On.Dispatch }}
  workflow_dispatch:
{{- with .Inputs }}
    inputs:
{{- range . }}
      {{ .Name }}:
        type: {{ .Type }}
{{- if .Description }}
        description: {{ printf "%q" .Description }}
{{- end }}
{{- if .Required }}
        required: true
{{- end }}
{{- if .HasDefault }}
        default: {{ .Default }}
{{- end }}
{{- if .Options }}
        options: {{ yamlList .Options }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- with .On.Schedule }}
  schedule:
{{- range . }}
    - cron: "{{ . }}"
{{- end }}
{{- end }}
{{- with $.Platform.Permissions }}
permissions:
{{- range . }}
  {{ .Key }}: {{ .Value }}
{{- end }}
{{- end }}
{{- with $.Platform.Concurrency }}
concurrency:
  group: {{ .Group }}
  cancel-in-progress: {{ .CancelInProgress }}
{{- end }}
{{- /* ResolverEnv is always present (the renderer-defined M6E_TAG/M6E_RUN_SCOPE
hoists); Env is the optional projectfile-authored env. Both render under one `env:`
block, ResolverEnv first so the hoists sit above authored entries. */}}
env:
{{- range $.ResolverEnv }}
  {{ .Key }}: {{ .Value }}
{{- end }}
{{- range $.Env }}
  {{ .Key }}: {{ .Value }}
{{- end }}
jobs:
{{- range .Jobs }}
  {{ .Name }}:
    runs-on: {{ with .RunsOn }}{{ . }}{{ else }}{{ $.Platform.RunsOn }}{{ end }}
{{- if $.Platform.TimeoutMinutes }}
    timeout-minutes: {{ $.Platform.TimeoutMinutes }}
{{- end }}
{{- if .Needs }}
    needs: {{ yamlList .Needs }}
{{- end }}
{{- if .If }}
    if: {{ .If }}
{{- end }}
{{- with .Concurrency }}
    concurrency:
      group: {{ .Group }}
      cancel-in-progress: {{ .CancelInProgress }}
{{- end }}
{{- if .Matrix }}
    strategy:
{{- if .MaxParallel }}
      max-parallel: {{ .MaxParallel }}
{{- end }}
      matrix:
{{- range .Matrix }}
        {{ .Key }}: {{ yamlList .Values }}
{{- end }}
{{- if .Include }}
        include:
{{- range .Include }}
          - {{ range $i, $kv := .Fields }}{{ if $i }}
            {{ end }}{{ $kv.Key }}: {{ printf "%q" $kv.Value }}{{ end }}
{{- end }}
{{- end }}
{{- if .Exclude }}
        exclude:
{{- range .Exclude }}
          - {{ range $i, $kv := .Fields }}{{ if $i }}
            {{ end }}{{ $kv.Key }}: {{ printf "%q" $kv.Value }}{{ end }}
{{- end }}
{{- end }}
{{- end }}
{{- if .Env }}
    env:
{{- range .Env }}
      {{ .Key }}: {{ .Value }}
{{- end }}
{{- end }}
    steps:{{ stepbody $.Target . }}
{{- end }}
