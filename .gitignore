# .gitignore — generated by `pf-bridge ignore`
# Stack: docker, container, go
# Edit projectfile [org.projectfile.ignores.git] include/exclude to
# customise — direct edits here are overwritten on the next generation.
# pf-cli-managed: yes

# >>> user-include
*.out
*.test
.container/*/locale/*.mo
.fetch
.makefile/bootstrap
/bin/
/dist/
coverage.html
coverage.out
reports/
# <<< user-include

# >>> user-extra
.env
.secrets/
# <<< user-extra

